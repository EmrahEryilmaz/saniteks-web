{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/kurumsal",
      "destination": "/kurumsal/hakkinda",
      "statusCode": 308,
      "regex": "^(?!/_next)/kurumsal(?:/)?$"
    },
    {
      "source": "/kalite",
      "destination": "/kalite/kalite-politikamiz",
      "statusCode": 308,
      "regex": "^(?!/_next)/kalite(?:/)?$"
    },
    {
      "source": "/images/logo/logo.png",
      "destination": "/images/logo/saniteks-logo.png",
      "statusCode": 308,
      "regex": "^(?!/_next)/images/logo/logo\\.png(?:/)?$"
    },
    {
      "source": "/icons/icon-192.png",
      "destination": "/icons/saniteks-icon-192.png",
      "statusCode": 308,
      "regex": "^(?!/_next)/icons/icon-192\\.png(?:/)?$"
    },
    {
      "source": "/icons/icon-512.png",
      "destination": "/icons/saniteks-icon-512.png",
      "statusCode": 308,
      "regex": "^(?!/_next)/icons/icon-512\\.png(?:/)?$"
    },
    {
      "source": "/icons/apple-icon.png",
      "destination": "/icons/saniteks-apple-icon.png",
      "statusCode": 308,
      "regex": "^(?!/_next)/icons/apple-icon\\.png(?:/)?$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ],
      "regex": "^/images(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/documents/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ],
      "regex": "^/documents(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/kalite/[slug]",
      "regex": "^/kalite/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/kalite/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/urunler/[kategori]",
      "regex": "^/urunler/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPkategori": "nxtPkategori"
      },
      "namedRegex": "^/urunler/(?<nxtPkategori>[^/]+?)(?:/)?$"
    },
    {
      "page": "/urunler/[kategori]/[urun]",
      "regex": "^/urunler/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPkategori": "nxtPkategori",
        "nxtPurun": "nxtPurun"
      },
      "namedRegex": "^/urunler/(?<nxtPkategori>[^/]+?)/(?<nxtPurun>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/apply",
      "regex": "^/api/apply(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/apply(?:/)?$"
    },
    {
      "page": "/api/contact",
      "regex": "^/api/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/contact(?:/)?$"
    },
    {
      "page": "/iletisim",
      "regex": "^/iletisim(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/iletisim(?:/)?$"
    },
    {
      "page": "/insan-kaynaklari",
      "regex": "^/insan\\-kaynaklari(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/insan\\-kaynaklari(?:/)?$"
    },
    {
      "page": "/kabiliyetler",
      "regex": "^/kabiliyetler(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/kabiliyetler(?:/)?$"
    },
    {
      "page": "/kataloglar",
      "regex": "^/kataloglar(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/kataloglar(?:/)?$"
    },
    {
      "page": "/kurumsal/grup-sirketleri",
      "regex": "^/kurumsal/grup\\-sirketleri(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/kurumsal/grup\\-sirketleri(?:/)?$"
    },
    {
      "page": "/kurumsal/hakkinda",
      "regex": "^/kurumsal/hakkinda(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/kurumsal/hakkinda(?:/)?$"
    },
    {
      "page": "/kurumsal/uretim-tesisleri",
      "regex": "^/kurumsal/uretim\\-tesisleri(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/kurumsal/uretim\\-tesisleri(?:/)?$"
    },
    {
      "page": "/kvkk-aydinlatma-metni",
      "regex": "^/kvkk\\-aydinlatma\\-metni(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/kvkk\\-aydinlatma\\-metni(?:/)?$"
    },
    {
      "page": "/manifest.webmanifest",
      "regex": "^/manifest\\.webmanifest(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/manifest\\.webmanifest(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    },
    {
      "page": "/surdurulebilirlik",
      "regex": "^/surdurulebilirlik(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/surdurulebilirlik(?:/)?$"
    },
    {
      "page": "/urunler",
      "regex": "^/urunler(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/urunler(?:/)?$"
    },
    {
      "page": "/urunler/ozel-marka-uretimi",
      "regex": "^/urunler/ozel\\-marka\\-uretimi(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/urunler/ozel\\-marka\\-uretimi(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}