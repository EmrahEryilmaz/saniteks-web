# Saniteks web — ortam değişkenleri
#
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun. Gerçek parolaları depoya eklemeyin;
# barındırma ortamında (Vercel, sunucu vb.) aynı değişkenleri ortam değişkeni olarak tanımlayın.
#
# İletişim formu (/api/contact) ve iş başvuru formu (/api/apply) e-postayı bu SMTP ayarlarıyla gönderir.
#  - Geliştirmede SMTP_HOST boşsa mesaj gönderilmez, sunucu konsoluna yazılır ve form başarılı döner.
#  - Üretimde SMTP_HOST (ve gönderen adresi) yoksa form 503 döner ve ziyaretçiye
#    e-posta/telefon ile ulaşmasını söyleyen bir mesaj gösterilir.

# SMTP sunucusunun adı. Örnek: smtp.yandex.com, smtp.office365.com, mail.alanadi.com.tr
SMTP_HOST=

# SMTP portu. Boş bırakılırsa SMTP_SECURE=true için 465, aksi halde 587 kullanılır.
SMTP_PORT=587

# true  → bağlantı baştan TLS ile kurulur (genellikle 465).
# false → düz bağlantı açılır ve STARTTLS zorunludur (genellikle 587); sunucu TLS sunmazsa gönderim yapılmaz.
SMTP_SECURE=false

# SMTP kimlik bilgileri. İkisi de doluysa kimlik doğrulama yapılır; sunucu gerektirmiyorsa boş bırakılabilir.
SMTP_USER=
SMTP_PASS=

# Form mesajlarının iletileceği adres (virgülle birden fazla adres yazılabilir).
# Boş bırakılırsa src/lib/site.ts içindeki adres kullanılır: info@saniteks.com.tr
CONTACT_TO=

# İş başvuru formundan gelen başvuruların (CV eki ile) ve iletişim formunda "İnsan Kaynakları" konulu
# mesajların iletileceği adres (virgülle birden fazla adres yazılabilir).
# Boş bırakılırsa src/lib/site.ts içindeki İK adresi kullanılır: ik@sanifoam.com.tr
# Gönderimde yukarıdaki SMTP ayarları ve aşağıdaki CONTACT_FROM kullanılır.
HR_TO=

# Gönderen (From) adresi. SMTP hesabının gönderim yetkisi olan bir adres olmalıdır.
# Boş bırakılırsa SMTP_USER kullanılır. Ziyaretçinin adresi Reply-To olarak eklenir, From olarak kullanılmaz.
# Örnek: "Saniteks Web Sitesi <web@saniteks.com.tr>"
CONTACT_FROM=
