{
  "name": "saniteks-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "package:plesk": "node scripts/package-plesk.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "i18n:extract": "node --experimental-strip-types --no-warnings --import ./scripts/i18n/register.mjs scripts/i18n/extract.ts",
    "i18n:check": "node --experimental-strip-types --no-warnings --import ./scripts/i18n/register.mjs scripts/i18n/extract.ts --check"
  },
  "dependencies": {
    "next": "16.4.4",
    "nodemailer": "^10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swiper": "^14.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/nodemailer": "^7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
