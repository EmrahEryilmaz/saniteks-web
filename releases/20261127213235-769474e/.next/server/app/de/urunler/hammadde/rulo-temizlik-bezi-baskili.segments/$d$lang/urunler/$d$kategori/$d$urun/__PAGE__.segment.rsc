am nach Bedarf festgelegt.",{"children":"Die Rollen werden nach Bedarf auf Breiten von 27 cm bis 210 cm geschnitten; die Rollenlänge beträgt in der Regel 300 m. Grammatur, Farbe, Muster und Maße werden gemeinsam nach Bedarf festgelegt."}]]}],["$","ul",null,{"className":"mt-8 grid max-w-xl gap-x-6 sm:grid-cols-2","children":[["$","li","80–320 g/m² Grammatur",{"className":"flex min-h-12 items-center gap-3 border-t border-border py-3 font-semibold","children":[["$","span",null,{"aria-hidden":"true","className":"size-2 shrink-0 bg-primary"}],"80–320 g/m² Grammatur"]}],["$","li","20–80 % Viskoseanteil",{"className":"flex min-h-12 items-center gap-3 border-t border-border py-3 font-semibold","children":[["$","span",null,{"aria-hidden":"true","className":"size-2 shrink-0 bg-primary"}],"20–80 % Viskoseanteil"]}],["$","li","Einfarbig, bedruckt und mit Mikrofaser",{"className":"flex min-h-12 items-center gap-3 border-t border-border py-3 font-semibold","children":[["$","span",null,{"aria-hidden":"true","className":"size-2 shrink-0 bg-primary"}],"Einfarbig, bedruckt und mit Mikrofaser"]}],["$","li","27–210 cm Rollenbreite",{"className":"flex min-h-12 items-center gap-3 border-t border-border py-3 font-semibold","children":[["$","span",null,{"aria-hidden":"true","className":"size-2 shrink-0 bg-primary"}],"27–210 cm Rollenbreite"]}]]}]]}]]}]}]
