ي واللون والنقشة والمقاس معًا حسب الحاجة."}]]}],["$","ul",null,{"className":"mt-8 grid max-w-xl gap-x-6 sm:grid-cols-2","children":[["$","li","وزن جرامي 80–320 غ/م²",{"className":"flex min-h-12 items-center gap-3 border-t border-border py-3 font-semibold","children":[["$","span",null,{"aria-hidden":"true","className":"size-2 shrink-0 bg-primary"}],"وزن جرامي 80–320 غ/م²"]}],["$","li","نسبة فيسكوز 20–80%",{"className":"flex min-h-12 items-center gap-3 border-t border-border py-3 font-semibold","children":[["$","span",null,{"aria-hidden":"true","className":"size-2 shrink-0 bg-primary"}],"نسبة فيسكوز 20–80%"]}],["$","li","سادة ومطبوعة وبألياف دقيقة",{"className":"flex min-h-12 items-center gap-3 border-t border-border py-3 font-semibold","children":[["$","span",null,{"aria-hidden":"true","className":"size-2 shrink-0 bg-primary"}],"سادة ومطبوعة وبألياف دقيقة"]}],["$","li","عرض اللفة 27–210 سم",{"className":"flex min-h-12 items-center gap-3 border-t border-border py-3 font-semibold","children":[["$","span",null,{"aria-hidden":"true","className":"size-2 shrink-0 bg-primary"}],"عرض اللفة 27–210 سم"]}]]}]]}]]}]}]
